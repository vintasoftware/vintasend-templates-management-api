# Shared secret required on every /api/v1 request:
#   Authorization: Bearer <VINTASEND_API_KEY>
VINTASEND_API_KEY=

# Optional. Dotted path to a callable `(request) -> None` that authenticates every /api/v1
# request in place of the shared key, refusing a caller by raising the app's ApiError.
# When it is set, VINTASEND_API_KEY is neither checked nor required.
VINTASEND_API_AUTHENTICATOR=

# Dotted path to the callable that builds your ManagedTemplateService (see README).
MANAGED_TEMPLATE_SERVICE_FACTORY=vintasend_templates_management_api.vintasend_config.create_template_service

# Optional. The backend name every new template is stored under. When set, it replaces the
# `templateManagedBackend` sent in a create request body, so a caller cannot label a template
# with another backend. Leave empty to store the body's value.
MANAGED_TEMPLATE_BACKEND_NAME=

# Optional. Dotted path to a callable `(request) -> str | None` that says who made a status
# change. When set, it replaces any `changedBy` sent in the request body, so a caller holding
# the API key cannot attribute a change to someone else. Leave empty to trust the body.
MANAGED_TEMPLATE_ACTOR_RESOLVER=

# Optional. Dotted path to a callable `(exc, request, request_id) -> None` that receives every
# unexpected error. Leave empty to log one line per error: its class name, the request id, the
# method and the route pattern -- never its message, traceback, the body or a preview context.
MANAGED_TEMPLATE_UNHANDLED_ERROR_HANDLER=

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when only server-side clients call this API.
VINTASEND_API_CORS_ORIGINS=

# --- Django ---------------------------------------------------------------------
# This API signs nothing -- no sessions, no cookies, no CSRF-protected forms -- so
# the secret key is only here because Django refuses to start without one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Comma-separated. Defaults to "*", which is only safe behind a proxy that sets Host.
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# The API never queries these itself. A database is only configured because some
# template-manager backends (notably vintasend-django-templates-manager) resolve
# their models through Django.
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
