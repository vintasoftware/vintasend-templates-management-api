# Shared secret required on every /api/v1 request:
#   Authorization: Bearer <VINTASEND_API_KEY>
VINTASEND_API_KEY=

# Dotted path to the callable that builds your ManagedTemplateService (see README).
MANAGED_TEMPLATE_SERVICE_FACTORY=vintasend_templates_management_api.vintasend_config.create_template_service

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when only server-side clients call this API.
VINTASEND_API_CORS_ORIGINS=

# --- Django ---------------------------------------------------------------------
# This API signs nothing -- no sessions, no cookies, no CSRF-protected forms -- so
# the secret key is only here because Django refuses to start without one.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
# Comma-separated. Defaults to "*", which is only safe behind a proxy that sets Host.
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# The API never queries these itself. A database is only configured because some
# template-manager backends (notably vintasend-django-templates-manager) resolve
# their models through Django.
DJANGO_DB_ENGINE=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
